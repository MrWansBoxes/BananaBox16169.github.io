---
import "../styles/global.css";
import { ClientRouter, slide } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.yaml";

const { title, description } = Astro.props;
const pageTitle = title
  ? `${title} — ${site.teamName} · FTC ${site.teamNumber}`
  : `${site.teamName} — FTC ${site.teamNumber}`;
const desc = description ?? site.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) {
            d.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/images/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <main transition:animate={slide({ duration: "0.3s" })}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        if (window.__bbMotion) return;
        window.__bbMotion = true;

        var REVEAL_SEL = ".hero__text,.hero__media,.intro,.stat__cell,.card,.tl__item,.member,.award,.sponsor,.pagehead,.prose,.tl-head";
        var bar = null;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function updateBar() {
          if (!bar) return;
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? h.scrollTop / max : 0) + ")";
        }
        window.addEventListener("scroll", updateBar, { passive: true });
        window.addEventListener("resize", updateBar);

        // Toggle dark mode when the nav button is clicked (delegated, so it
        // keeps working after page transitions swap the button out).
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest("#theme-toggle");
          if (!btn) return;
          var dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (err) {}
        });

        function applyTheme() {
          try {
            var t = localStorage.getItem("theme");
            var dark = t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.classList.toggle("dark", dark);
          } catch (e) {}
        }

        // Page transitions reset the <html> class list on every navigation,
        // which strips the "js" and "dark" classes. Re-add them (and clear
        // the revealed markers) after each swap, before the slide snapshots.
        document.addEventListener("astro:after-swap", function () {
          document.documentElement.classList.add("js");
          applyTheme();
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) {
            el.classList.remove("is-visible");
          });
        });

        function setup() {
          bar = document.getElementById("scroll-progress");
          updateBar();

          if (reduce || !("IntersectionObserver" in window)) return;
          [".stat__row", ".cards", ".tl", ".grid", ".awards", ".sponsors"].forEach(function (sel) {
            document.querySelectorAll(sel).forEach(function (group) {
              Array.prototype.forEach.call(group.children, function (child, i) {
                child.style.setProperty("--reveal-delay", i * 80 + "ms");
              });
            });
          });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: "0px" });
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) { io.observe(el); });
        }

        document.addEventListener("astro:page-load", setup);
      })();
    </script>
  </body>
</html>