---
import "../styles/global.css";
import { ClientRouter, slide } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.yaml";

const { title, description } = Astro.props;
const siteName = `${site.teamName} FTC ${site.teamNumber}`;
const pageTitle = `${title ?? "Home"} | ${siteName}`;
const desc = description ?? site.tagline;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) {
            d.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <main id="main-content" tabindex="-1" transition:animate={slide({ duration: "0.3s" })}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        if (window.__bbMotion) return;
        window.__bbMotion = true;

        var REVEAL_SEL = ".hero__text,.hero__media,.intro,.stat__cell,.card,.tl__item,.member,.award,.outreach-entry,.sponsor,.pagehead,.prose,.tl-head";
        var bar = null;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function syncThemeButton(dark) {
          var btn = document.getElementById("theme-toggle");
          if (!btn) return;
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        }

        function setNavOpen(open, returnFocus) {
          var btn = document.getElementById("nav-toggle");
          var nav = document.getElementById("primary-navigation");
          if (!btn || !nav) return;
          btn.setAttribute("aria-expanded", String(open));
          btn.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
          nav.dataset.open = String(open);
          if (returnFocus) btn.focus();
        }

        function updateBar() {
          if (!bar) return;
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? h.scrollTop / max : 0) + ")";
        }
        window.addEventListener("scroll", updateBar, { passive: true });
        window.addEventListener("resize", updateBar);

        // Toggle dark mode when the nav button is clicked (delegated, so it
        // keeps working after page transitions swap the button out).
        document.addEventListener("click", function (e) {
          var btn = e.target.closest && e.target.closest("#theme-toggle");
          if (!btn) return;
          var dark = document.documentElement.classList.toggle("dark");
          syncThemeButton(dark);
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (err) {}
        });

        document.addEventListener("click", function (e) {
          var toggle = e.target.closest && e.target.closest("#nav-toggle");
          if (toggle) {
            setNavOpen(toggle.getAttribute("aria-expanded") !== "true", false);
            return;
          }
          if (e.target.closest && e.target.closest("#primary-navigation a")) {
            setNavOpen(false, false);
          }
        });

        document.addEventListener("keydown", function (e) {
          var toggle = document.getElementById("nav-toggle");
          if (e.key === "Escape" && toggle && toggle.getAttribute("aria-expanded") === "true") {
            setNavOpen(false, true);
          }
        });

        function applyTheme() {
          try {
            var t = localStorage.getItem("theme");
            var dark = t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.classList.toggle("dark", dark);
            syncThemeButton(dark);
          } catch (e) {}
        }

        // Page transitions reset the <html> class list on every navigation,
        // which strips the "js" and "dark" classes. Re-add them (and clear
        // the revealed markers) after each swap, before the slide snapshots.
        document.addEventListener("astro:after-swap", function () {
          document.documentElement.classList.add("js");
          applyTheme();
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) {
            el.classList.remove("is-visible");
          });
        });

        function setup() {
          bar = document.getElementById("scroll-progress");
          updateBar();
          syncThemeButton(document.documentElement.classList.contains("dark"));

          if (reduce) return;
          if (!("IntersectionObserver" in window)) {
            document.querySelectorAll(REVEAL_SEL).forEach(function (el) {
              el.classList.add("is-visible");
            });
            return;
          }
          [".stat__row", ".cards", ".tl", ".grid", ".awards", ".outreach-list", ".sponsors"].forEach(function (sel) {
            document.querySelectorAll(sel).forEach(function (group) {
              Array.prototype.forEach.call(group.children, function (child, i) {
                var delayIndex = sel === ".grid" ? i % 4 : i;
                child.style.setProperty("--reveal-delay", delayIndex * 80 + "ms");
              });
            });
          });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: "0px" });
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) { io.observe(el); });
        }

        document.addEventListener("astro:page-load", setup);
      })();
    </script>
  </body>
</html>
