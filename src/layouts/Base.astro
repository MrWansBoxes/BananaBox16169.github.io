---
import "../styles/global.css";
import { ClientRouter, slide } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.yaml";

const { title, description } = Astro.props;
const pageTitle = title
  ? `${title} — ${site.teamName} · FTC ${site.teamNumber}`
  : `${site.teamName} — FTC ${site.teamNumber}`;
const desc = description ?? site.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/images/favicon.png" />

    <!-- Fonts: Archivo (display), IBM Plex Sans (body), IBM Plex Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <main transition:animate={slide({ duration: "0.3s" })}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        if (window.__bbMotion) return;
        window.__bbMotion = true;

        var REVEAL_SEL = ".hero__text,.hero__media,.intro,.stat__cell,.card,.tl__item,.member,.award,.sponsor,.pagehead,.prose,.tl-head";
        var bar = null;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function updateBar() {
          if (!bar) return;
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.transform = "scaleX(" + (max > 0 ? h.scrollTop / max : 0) + ")";
        }
        window.addEventListener("scroll", updateBar, { passive: true });
        window.addEventListener("resize", updateBar);

        // Before each page transition, clear the "revealed" marker on the
        // incoming page so the fade replays every time — including on Back.
        document.addEventListener("astro:before-swap", function (e) {
          e.newDocument.querySelectorAll(REVEAL_SEL).forEach(function (el) {
            el.classList.remove("is-visible");
          });
        });

        function setup() {
          bar = document.getElementById("scroll-progress");
          updateBar();

          if (reduce || !("IntersectionObserver" in window)) return;
          // Stagger items inside these groups so they cascade in
          [".stat__row", ".cards", ".tl", ".grid", ".awards", ".sponsors"].forEach(function (sel) {
            document.querySelectorAll(sel).forEach(function (group) {
              Array.prototype.forEach.call(group.children, function (child, i) {
                child.style.setProperty("--reveal-delay", i * 80 + "ms");
              });
            });
          });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: "0px" });
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) { io.observe(el); });
        }

        // Runs on first load AND after every page transition
        document.addEventListener("astro:page-load", setup);
      })();
    </script>
  </body>
</html>