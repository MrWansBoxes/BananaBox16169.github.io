---
import site from "../data/site.yaml";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/team", label: "Team" },
  { href: "/robot", label: "Robot" },
  { href: "/outreach", label: "Outreach" },
  { href: "/awards", label: "Awards" },
  { href: "/support", label: "Support" },
];
const isActive = (href) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">
      <span class="nav__num">{site.teamNumber}</span>
      <span class="nav__name">{site.teamName}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__check" hidden />
    <label for="nav-toggle" class="nav__burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["nav__link", { "nav__link--active": isActive(l.href) }]}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <a class="btn btn--peel nav__cta" href={site.contactUrl} target="_blank" rel="noopener">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 68px; gap: 1rem;
  }
  .nav__brand {
    display: inline-flex; align-items: baseline; gap: 0.55ch;
    text-decoration: none; font-family: var(--font-display);
    font-weight: 900; letter-spacing: -0.02em;
  }
  .nav__num {
    font-family: var(--font-mono); font-weight: 700; font-size: 0.95rem;
    background: var(--peel); color: var(--ink);
    padding: 0.15em 0.5em; border-radius: 4px; letter-spacing: 0;
  }
  .nav__name { font-size: 1.35rem; }

  .nav__links { display: flex; align-items: center; gap: clamp(0.6rem, 1.6vw, 1.6rem); }
  .nav__link {
    text-decoration: none; font-family: var(--font-mono);
    font-size: 0.82rem; font-weight: 500; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--ink);
    padding: 0.3em 0; position: relative;
  }
  .nav__link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -2px;
    height: 3px; background: var(--peel); transform: scaleX(0);
    transform-origin: left; transition: transform 0.18s ease;
  }
  .nav__link:hover::after,
  .nav__link--active::after { transform: scaleX(1); }
  .nav__cta { padding: 0.55em 1em; }

  /* Mobile menu */
  .nav__burger { display: none; cursor: pointer; padding: 8px; }
  .nav__burger span {
    display: block; width: 26px; height: 2.5px; background: var(--ink);
    margin: 5px 0; transition: transform 0.2s ease, opacity 0.2s ease;
  }
  @media (max-width: 820px) {
    .nav__burger { display: block; }
    .nav__links {
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 0.2rem;
      background: var(--paper); border-bottom: 2px solid var(--ink);
      padding: 1rem var(--gutter) 1.4rem;
      max-height: 0; overflow: hidden; padding-block: 0;
      transition: max-height 0.25s ease, padding-block 0.25s ease;
    }
    .nav__check:checked ~ .nav__links { max-height: 420px; padding-block: 1rem 1.4rem; }
    .nav__link { font-size: 1rem; padding: 0.5em 0; }
    .nav__cta { margin-top: 0.5rem; }
  }
</style>
