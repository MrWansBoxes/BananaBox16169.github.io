---
import { Image } from "astro:assets";
import team from "../data/team.yaml";
const { members = team, eagerCount = 0 } = Astro.props;
const importedPhotos = import.meta.glob("../assets/images/team/*", { eager: true, import: "default" });
const photos = Object.fromEntries(
  Object.entries(importedPhotos).map(([path, photo]) => [`team/${path.split("/").pop()}`, photo]),
);
const initials = (name) =>
  name.split(" ").map((w) => w[0]).slice(0, 2).join("").toUpperCase();

const missingPhotos = members.filter((member) => member.photo && !photos[member.photo]);
if (missingPhotos.length > 0) {
  throw new Error(`Missing team photos: ${missingPhotos.map((member) => member.photo).join(", ")}`);
}

const widthsFor = (photo) => {
  const maximumWidth = Math.min(photo.width, 512);
  return [...new Set([160, 240, 320, 480, maximumWidth].filter((width) => width <= maximumWidth))];
};
---

<ul class="grid">
  {members.map((m, index) => {
    const photo = photos[m.photo];
    const isEager = index < eagerCount;

    return (
      <li class="member">
        <div class="member__photo">
          {photo
            ? <Image
                src={photo}
                alt={m.name}
                width={Math.min(photo.width, 512)}
                widths={widthsFor(photo)}
                sizes="(max-width: 340px) calc(100vw - 40px), (max-width: 480px) calc((100vw - 56px) / 2), 250px"
                format="webp"
                quality={82}
                loading={isEager ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={index === 0 && isEager ? "high" : "auto"}
              />
            : <span class="member__initials">{initials(m.name)}</span>}
        </div>
        <p class="member__name">{m.name}</p>
        <p class="member__role">{m.role}</p>
      </li>
    );
  })}
</ul>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: clamp(1.4rem, 2.5vw, 1.8rem) 1.5rem;
  }
  .member__photo {
    aspect-ratio: 1; border: 2px solid var(--ink); border-radius: var(--radius);
    background: var(--peel); overflow: hidden;
    display: grid; place-items: center;
  }
  .member__photo img { width: 100%; height: 100%; object-fit: cover; }
  .member__initials {
    font-family: var(--font-display); font-weight: 900;
    font-size: 2.6rem; color: var(--ink);
  }
  .member__name {
    margin: 0.85rem 0 0.2rem; font-family: var(--font-display);
    font-weight: 800; font-size: 1.2rem; line-height: 1.15;
  }
  .member__role {
    margin: 0; font-family: var(--font-mono); font-size: 0.78rem;
    letter-spacing: 0.02em; line-height: 1.45; color: var(--bruise);
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
    .member__name { font-size: 1.05rem; }
    .member__role { font-size: 0.7rem; }
  }
  @media (max-width: 340px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
