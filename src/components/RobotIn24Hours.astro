---
import { Image } from "astro:assets";
import robots from "../data/robots.yaml";
import robotIn24Hours from "../data/robot-in-24-hours.yaml";
import robotIn24HoursTeam from "../assets/images/seasons/biobuzz/RobotIn24H/RobotIn24HTeam.JPG";
import aTeamRobot from "../assets/images/seasons/biobuzz/RobotIn24H/TeamARobot.JPG";
import aTeamProgress from "../assets/images/seasons/biobuzz/RobotIn24H/TeamARobotProg24H.jpg";
import aTeamShooter from "../assets/images/seasons/biobuzz/RobotIn24H/TeamAShooter24H.jpg";
import bTeamRobot from "../assets/images/seasons/biobuzz/RobotIn24H/TeamBRobot.JPG";
import bTeamProgress from "../assets/images/seasons/biobuzz/RobotIn24H/b-team-robot-in-24-hours-progress.jpg";

const robotImages = {
  "TeamARobot.JPG": aTeamRobot,
  "TeamARobotProg24H.jpg": aTeamProgress,
  "TeamAShooter24H.jpg": aTeamShooter,
  "TeamBRobot.JPG": bTeamRobot,
  "b-team-robot-in-24-hours-progress.jpg": bTeamProgress,
};
---

<section id="robot-in-24-hours" class="robot-event outreach-entry" aria-labelledby="robot-event-title">
  <h3 id="robot-event-title">{robotIn24Hours.title}</h3>
  <p class="robot-event__lede">
    A 24-hour build challenge where our two robot subteams built functional robots while sharing progress and lessons with other FTC teams.
  </p>
  <details class="robot-event__details">
    <summary>Explore Robot in 24 Hours</summary>
    <div class="robot-event__details-content">
      <section class="robot-event__overview" aria-labelledby="robot-event-overview-title">
        <h4 id="robot-event-overview-title">Event overview</h4>
        <p class="robot-event__schedule">
          <time datetime={robotIn24Hours.schedule.start.datetime}>{robotIn24Hours.schedule.start.label}</time>
          <span> through </span>
          <time datetime={robotIn24Hours.schedule.end.datetime}>{robotIn24Hours.schedule.end.label}</time>
        </p>
        <p>{robotIn24Hours.summary}</p>
        <p>{robotIn24Hours.context}</p>
        <p>{robotIn24Hours.outreach}</p>
        <ul>
          {robotIn24Hours.robotFacts.map((fact) => <li>{fact}</li>)}
        </ul>
        <figure class="robot-event__figure robot-event__shared-figure">
          <div class="robot-event__frame">
            <Image
              src={robotIn24HoursTeam}
              alt="Banana Box A Team and B Team with both completed Robot in 24 Hours robots"
              width={robotIn24HoursTeam.width}
              widths={[320, 480, 640, 800, 1024]}
              sizes="(max-width: 520px) calc(100vw - 88px), (max-width: 960px) calc(100vw - 160px), 720px"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>Banana Box after completing Robot in 24 Hours with both A Team and B Team robots.</figcaption>
        </figure>
      </section>

      <div class="robot-event__teams">
        {robotIn24Hours.teams.map((eventTeam) => {
          const robot = robots.find((item) => item.id === eventTeam.robotId);
          const completedImage = robotImages[eventTeam.completedImage.asset];
          if (!completedImage) {
            throw new Error(`Missing completed Robot in 24 Hours image: ${eventTeam.completedImage.asset}`);
          }

          return (
            <section class="robot-event__team" aria-labelledby={`robot-event-${eventTeam.robotId}-title`}>
              <h4 id={`robot-event-${eventTeam.robotId}-title`}>{robot.label.replace(" Robot", "")}</h4>
              <p class="robot-event__eyebrow">Build progress</p>
              <div
                class:list={[
                  "robot-event__gallery",
                  { "robot-event__gallery--single": eventTeam.images.length === 1 },
                ]}
              >
                {eventTeam.images.map((image) => {
                  const asset = robotImages[image.asset];
                  if (!asset) throw new Error(`Missing Robot in 24 Hours image: ${image.asset}`);

                  return (
                    <figure class="robot-event__figure">
                      <div class="robot-event__frame">
                        <Image
                          src={asset}
                          alt={image.alt}
                          width={Math.min(asset.width, 720)}
                          widths={[240, 360, 480, 720]}
                          sizes="(max-width: 520px) calc(100vw - 88px), 330px"
                          format="webp"
                          quality={82}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <figcaption>{image.caption}</figcaption>
                    </figure>
                  );
                })}
              </div>
              <p class="robot-event__eyebrow robot-event__eyebrow--completed">Completed robot</p>
              <figure class="robot-event__figure robot-event__completed">
                <div class="robot-event__frame">
                  <Image
                    src={completedImage}
                    alt={eventTeam.completedImage.alt}
                    width={completedImage.width}
                    widths={[320, 480, 640, 800, 1024]}
                    sizes="(max-width: 520px) calc(100vw - 88px), 520px"
                    format="webp"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>{eventTeam.completedImage.caption}</figcaption>
              </figure>
              <p class="robot-event__repo-row">
                <a class="robot-event__repo" href={eventTeam.repository.url}>
                  {eventTeam.repository.label}
                </a>
              </p>
            </section>
          );
        })}
      </div>
    </div>
  </details>
</section>

<style>
  .robot-event {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: var(--card-pad);
    scroll-margin-top: 90px;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
  }
  .robot-event > h3 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .robot-event__lede { max-width: 70ch; margin: 0.7rem 0 0; color: var(--bruise); }
  .robot-event__details { margin-top: 1.2rem; }
  .robot-event__details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .robot-event__details summary::-webkit-details-marker { display: none; }
  .robot-event__details summary::after {
    content: "+";
    flex: 0 0 auto;
    font-size: 1.2rem;
    line-height: 1;
  }
  .robot-event__details summary:hover,
  .robot-event__details[open] summary {
    color: #1B1A17;
    background: var(--peel);
  }
  .robot-event__details[open] summary { border-radius: var(--radius) var(--radius) 0 0; }
  .robot-event__details[open] summary::after { content: "−"; }
  .robot-event__details summary:focus-visible {
    outline: 3px solid var(--leaf);
    outline-offset: 3px;
  }
  .robot-event__details-content {
    padding: clamp(1rem, 3vw, 1.6rem);
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .robot-event__details-content p { max-width: 70ch; margin: 0; color: var(--ink); }
  .robot-event__details-content p + p { margin-top: 0.9rem; }
  .robot-event__details-content ul { margin: 1rem 0 0; padding-left: 1.25rem; }
  .robot-event__details-content li { margin-bottom: 0.35rem; color: var(--ink); }
  .robot-event__overview h4,
  .robot-event__team h4 { font-size: clamp(1.35rem, 3vw, 1.8rem); }
  .robot-event__details-content .robot-event__schedule {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--bruise);
  }
  .robot-event__teams {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 3rem);
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: clamp(1.5rem, 4vw, 2.2rem);
    border-top: 2px solid var(--ink);
  }
  .robot-event__team { min-width: 0; }
  .robot-event__eyebrow {
    margin: 1.2rem 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bruise);
  }
  .robot-event__eyebrow--completed { margin-top: clamp(1.8rem, 4vw, 2.5rem); }
  .robot-event__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    max-width: 680px;
  }
  .robot-event__gallery--single { grid-template-columns: 1fr; max-width: 330px; }
  .robot-event__figure { margin: 0; }
  .robot-event__completed { max-width: 520px; }
  .robot-event__shared-figure { max-width: 720px; margin-top: clamp(1.5rem, 3vw, 2rem); }
  .robot-event__frame {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--peel);
  }
  .robot-event__frame img { width: 100%; height: auto; object-fit: contain; }
  .robot-event__gallery:not(.robot-event__gallery--single) .robot-event__frame { aspect-ratio: 9 / 10; }
  .robot-event__gallery:not(.robot-event__gallery--single) .robot-event__frame img { height: 100%; }
  .robot-event__gallery:not(.robot-event__gallery--single) .robot-event__figure:nth-child(2) img {
    object-fit: cover;
    object-position: center top;
  }
  .robot-event__figure figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--bruise);
  }
  .robot-event__details-content .robot-event__repo-row { margin-top: 1.2rem; }
  .robot-event__repo {
    color: var(--link);
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .robot-event__repo:hover { color: var(--ink); background: var(--peel); }
  @media (max-width: 760px) {
    .robot-event__teams { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .robot-event__gallery { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
