---
import robots from "../data/robots.yaml";
import robotIn24Hours from "../data/robot-in-24-hours.yaml";
---

<fieldset class="robot-switcher">
  <legend>Choose a robot</legend>
  {robots.map((robot, index) => (
    <Fragment>
      <input
        type="radio"
        name="current-robot"
        id={`robot-${robot.id}`}
        aria-controls={`robot-panel-${robot.id}`}
        checked={index === 0}
      />
      <label id={`robot-label-${robot.id}`} for={`robot-${robot.id}`}>{robot.label}</label>
    </Fragment>
  ))}

  <div class="robot-panels">
    {robots.map((robot) => {
      const eventTeam = robotIn24Hours.teams.find((team) => team.robotId === robot.id);

      return (
        <section
          class="robot-panel"
          id={`robot-panel-${robot.id}`}
          data-robot={robot.id}
          aria-labelledby={`robot-label-${robot.id}`}
        >
          <p class="robot-panel__status">{robot.status}</p>
          <h2>{robot.label}</h2>
          <p class="robot-panel__description">{robot.description}</p>

          <section class="robot-event">
            <p class="robot-event__eyebrow">24-hour build</p>
            <h3>{robotIn24Hours.title}</h3>
            <ul>
              {robotIn24Hours.robotFacts.map((fact) => <li>{fact}</li>)}
            </ul>
            <p>
              <a class="robot-event__repo" href={eventTeam.repository.url}>
                {eventTeam.repository.label}
              </a>
            </p>
            {eventTeam.images && (
              <div
                class:list={[
                  "robot-event__gallery",
                  { "robot-event__gallery--single": eventTeam.images.length === 1 },
                ]}
              >
                {eventTeam.images.map((image) => (
                  <figure class="robot-event__figure">
                    <div class="robot-event__frame">
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                      />
                    </div>
                    <figcaption>{image.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </section>
        </section>
      );
    })}
  </div>
</fieldset>

<style>
  .robot-switcher {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 860px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .robot-switcher legend {
    grid-column: 1 / -1;
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bruise);
  }
  .robot-switcher input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .robot-switcher label {
    display: grid;
    place-items: center;
    min-height: 54px;
    padding: 0.75rem 1rem;
    background: var(--paper);
    border: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .robot-switcher label:first-of-type {
    border-radius: var(--radius) 0 0 var(--radius);
  }
  .robot-switcher label:last-of-type {
    margin-left: -2px;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .robot-switcher input:checked + label {
    position: relative;
    z-index: 1;
    background: var(--peel);
    color: #1B1A17;
  }
  .robot-switcher input:focus-visible + label {
    position: relative;
    z-index: 2;
    outline: 3px solid var(--leaf);
    outline-offset: 3px;
  }
  .robot-panels {
    grid-column: 1 / -1;
    margin-top: 2rem;
  }
  .robot-panel {
    display: none;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 10px 10px 0 var(--peel);
  }
  .robot-panel__status {
    margin: 0 0 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bruise);
  }
  .robot-panel h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .robot-panel__description { max-width: 58ch; margin: 1rem 0 0; }
  .robot-event {
    margin-top: clamp(2rem, 5vw, 3.2rem);
    padding-top: clamp(1.5rem, 4vw, 2.2rem);
    border-top: 2px solid var(--ink);
  }
  .robot-event__eyebrow {
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bruise);
  }
  .robot-event h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .robot-event ul { margin: 1.2rem 0; padding-left: 1.25rem; }
  .robot-event li { margin-bottom: 0.35rem; }
  .robot-event__repo {
    color: var(--peel-deep);
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .robot-event__repo:hover { color: var(--ink); background: var(--peel); }
  .robot-event__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    max-width: 680px;
    margin-top: 2rem;
  }
  .robot-event__gallery--single {
    grid-template-columns: 1fr;
    max-width: 520px;
  }
  .robot-event__figure { margin: 0; }
  .robot-event__frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--peel);
  }
  .robot-event__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .robot-event__figure figcaption {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--bruise);
  }
  #robot-a-team:checked ~ .robot-panels [data-robot="a-team"],
  #robot-b-team:checked ~ .robot-panels [data-robot="b-team"] {
    display: block;
  }
  @media (max-width: 520px) {
    .robot-switcher label { padding-inline: 0.6rem; font-size: 0.76rem; }
    .robot-event__gallery { grid-template-columns: 1fr; }
  }
</style>
