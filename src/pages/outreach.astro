---
import Base from "../layouts/Base.astro";
import OutreachList from "../components/OutreachList.astro";
import RobotIn24Hours from "../components/RobotIn24Hours.astro";
import Timeline from "../components/Timeline.astro";
import outreach from "../data/outreach.yaml";
import robotIn24Hours from "../data/robot-in-24-hours.yaml";
import { getCurrentOutreach, splitOutreachAroundDate } from "../utils/outreach.js";
import { getCurrentTimeline } from "../utils/timeline.js";
import { Content } from "../copy/outreach.md";

const currentOutreach = getCurrentOutreach(outreach.entries);
const currentTimeline = getCurrentTimeline(outreach.entries);
const robotEventDate = robotIn24Hours.schedule.end.datetime.slice(0, 10);
const { before: outreachBeforeRobot, after: outreachAfterRobot } =
  splitOutreachAroundDate(currentOutreach, robotEventDate);
---
<Base title="Outreach" description="How Banana Box brings FIRST to thousands of people.">
  <section class="wrap pagehead">
    <p class="eyebrow">Community</p>
    <h1>Outreach &amp; impact</h1>
    <p>Spreading FIRST robotics through workshops, events, and partnerships.</p>
  </section>
  <section class="wrap section section--flush-top section--flow">
    <article class="prose"><Content /></article>
  </section>
  <section class="wrap section section--flush-top">
    <p class="eyebrow">Season timeline</p>
    <h2 class="outreach-heading">Robot and outreach, month by month</h2>
    <Timeline items={currentTimeline} />
  </section>
  <section class="section section--paper2">
    <div class="wrap">
      <p class="eyebrow">Outreach in detail</p>
      <h2 class="outreach-heading">Our Impact</h2>
      <OutreachList items={outreachBeforeRobot} />
      <RobotIn24Hours />
      <OutreachList items={outreachAfterRobot} />
    </div>
  </section>
</Base>

<style>
  .outreach-heading { max-width: 22ch; margin: 0.4rem 0 clamp(2rem, 4vw, 2.6rem); }
</style>
