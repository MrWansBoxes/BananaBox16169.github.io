---
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import AwardList from "../../components/AwardList.astro";
import BetaTesting from "../../components/BetaTesting.astro";
import OutreachList from "../../components/OutreachList.astro";
import StatStrip from "../../components/StatStrip.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import Timeline from "../../components/Timeline.astro";
import decodeAwards from "../../data/seasons/decode/awards.yaml";
import decodeMilestones from "../../data/seasons/decode/milestones.yaml";
import outreach from "../../data/outreach.yaml";
import robotIn24Hours from "../../data/robot-in-24-hours.yaml";
import seasons from "../../data/seasons.yaml";
import team from "../../data/team.yaml";
import { getSeasonOutreach } from "../../utils/outreach.js";
import { Content as DecodeRobot } from "../../copy/seasons/decode/robot.md";
import { Content as DecodeWhoWeAre } from "../../copy/seasons/decode/who-we-are.md";
import bumblebeeImage from "../../assets/images/seasons/decode/bumblebee.png";

export function getStaticPaths() {
  return seasons.map((season) => ({
    params: { slug: season.slug },
    props: { season },
  }));
}

const { season } = Astro.props;
const status = season.current ? "Current season" : "Season archive";
const isDecode = season.slug === "decode";
const decodeOutreach = getSeasonOutreach(outreach.entries, "decode");
const decodeHighlights = [
  ...outreach.summaries.decode.metrics,
  { value: "4", label: "Robot Iterations" },
];
const decodeTeam = team.filter((member) => member.photo);
const gearUp = outreach.entries.find((entry) => entry.id === "gear-up-workshop-series");
---

<Base
  title={`${season.name} ${season.year}`}
  description={`${season.name}, the ${season.year} season for FTC Team 16169 Banana Box.`}
>
  <section class="wrap pagehead">
    <p class="eyebrow">{status}</p>
    <h1>{season.name}</h1>
    <p>{season.year}</p>
  </section>

  {isDecode ? (
    <>
      <StatStrip items={decodeHighlights} />

      <section id="team" class="wrap section archive-section">
        <p class="eyebrow">Who we were</p>
        <h2>The DECODE team.</h2>
        <article class="prose archive-who"><DecodeWhoWeAre /></article>
        <p class="eyebrow roster-label">Season roster</p>
        <TeamGrid members={decodeTeam} />
      </section>

      <section id="robot" class="section section--paper2 archive-section">
        <div class="wrap">
        <p class="eyebrow">Robot &amp; engineering</p>
        <h2>Bumblebee</h2>
        <div class="robot-archive">
          <div class="robot-archive__media">
            <Image
              src={bumblebeeImage}
              alt="Bumblebee, Banana Box's DECODE robot"
              width={800}
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 800px) calc(100vw - 40px), 400px"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="robot-archive__content">
            <article class="prose"><DecodeRobot /></article>
            <BetaTesting season="decode" />
          </div>
        </div>
        </div>
      </section>

      <section id="timeline" class="wrap section archive-section">
          <p class="eyebrow">Robot timeline</p>
          <h2>DECODE, month by month.</h2>
          <div class="archive-content"><Timeline items={decodeMilestones} /></div>
      </section>

      <section id="outreach" class="section section--paper2 archive-section">
        <div class="wrap">
        <p class="eyebrow">Outreach &amp; impact</p>
        <h2>DECODE Outreach</h2>
        <p class="archive-lede">{outreach.summaries.decode.description}</p>
        <div class="archive-content"><OutreachList items={decodeOutreach} /></div>
        </div>
      </section>

      <section id="awards" class="wrap section archive-section">
          <p class="eyebrow">Recognition</p>
          <h2>DECODE awards.</h2>
          <div class="archive-content"><AwardList items={decodeAwards} /></div>
      </section>

      <section class="wrap archive-back">
        <a class="btn btn--ghost" href="/seasons">
          <span aria-hidden="true">←</span> All seasons
        </a>
      </section>
    </>
  ) : (
    <>
      <section class="wrap section section--flush-top">
        <article class="season-shell">
          <h2>Season in progress</h2>
          <p>This season is currently in progress. This page is ready for updates as BIOBUZZ develops.</p>
          <div class="season-shell__actions">
            <a class="btn btn--peel" href="/robot">View current robot</a>
            <a class="btn btn--ghost" href="/seasons">
              <span aria-hidden="true">←</span> All seasons
            </a>
          </div>
        </article>
      </section>

      <section class="section section--paper2">
        <div class="wrap current-event">
          <p class="eyebrow">Season milestone</p>
          <h2>{robotIn24Hours.title}</h2>
          <p class="current-event__schedule">
            <time datetime={robotIn24Hours.schedule.start.datetime}>{robotIn24Hours.schedule.start.label}</time>
            <span> through </span>
            <time datetime={robotIn24Hours.schedule.end.datetime}>{robotIn24Hours.schedule.end.label}</time>
          </p>
          <p>{robotIn24Hours.summary}</p>
          <p>{robotIn24Hours.context}</p>
          <a class="btn btn--peel" href="/robot">View A/B robot details</a>
        </div>
      </section>

      {gearUp && (
        <section id="outreach" class="wrap section current-outreach">
          <p class="eyebrow">Ongoing outreach</p>
          <h2>{gearUp.title}</h2>
          <p class="archive-lede">{gearUp.description}</p>
          <p class="archive-lede">Started in August 2026 and continuing through the season.</p>
          <a class="btn btn--peel" href="/outreach#gear-up-workshop-series">View completed sessions</a>
        </section>
      )}
    </>
  )}
</Base>

<style>
  .season-shell {
    max-width: 760px;
    padding: var(--panel-pad);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .season-shell h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .season-shell p {
    max-width: 55ch;
    margin: 1rem 0 2rem;
    color: var(--bruise);
  }
  .season-shell__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .current-event h2 { max-width: 22ch; }
  .current-event > p { max-width: 64ch; color: var(--bruise); }
  .current-event__schedule {
    margin: 1.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .current-event .btn { margin-top: 1rem; }
  .current-outreach h2 { max-width: 22ch; }
  .current-outreach .btn { margin-top: 1.2rem; }
  .archive-section { scroll-margin-top: 90px; }
  .archive-section > h2,
  .archive-section > .wrap > h2 { max-width: 22ch; }
  .archive-who {
    margin-top: 1.2rem; font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.5;
  }
  .archive-who :global(strong) {
    color: #1B1A17; background: var(--peel); padding: 0 0.15em;
  }
  .roster-label { margin-top: clamp(3rem, 6vw, 5rem); }
  .archive-lede { max-width: 64ch; margin: 1rem 0 0; color: var(--bruise); }
  .archive-content { margin-top: 2.4rem; }
  .robot-archive {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(2rem, 4vw, 2.6rem);
  }
  .robot-archive__media {
    position: sticky;
    top: 100px;
    overflow: hidden;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .robot-archive__media img { width: 100%; height: auto; aspect-ratio: 1070 / 960; object-fit: contain; }
  .archive-back { padding-block: 0 var(--section-space); }
  @media (max-width: 800px) {
    .robot-archive { grid-template-columns: 1fr; }
    .robot-archive__media { position: static; }
  }
</style>
