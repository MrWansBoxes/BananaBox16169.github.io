---
import Base from "../layouts/Base.astro";
import AwardList from "../components/AwardList.astro";
import awards from "../data/awards.yaml";
---
<Base title="Awards" description="Recognition earned by FTC Team 16169 Banana Box.">
  <section class="wrap pagehead">
    <p class="eyebrow">Recognition</p>
    <h1>Awards</h1>
    <p>Honors earned on the field and in the judging room.</p>
  </section>
  <section class="wrap section section--flush-top">
    {awards.length > 0 ? (
      <AwardList items={awards} />
    ) : (
      <article class="awards-empty">
        <h2>BIOBUZZ is in progress.</h2>
        <p>Awards and competition results will be added as the season develops.</p>
        <a class="btn btn--ghost" href="/seasons/decode#awards">View 2025–2026 awards</a>
      </article>
    )}
  </section>
</Base>

<style>
  .awards-empty {
    max-width: 760px; padding: var(--panel-pad);
    background: var(--paper); border: 2px solid var(--ink);
    border-radius: var(--radius); box-shadow: var(--shadow-card);
  }
  .awards-empty h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .awards-empty p { max-width: 55ch; margin: 1rem 0 2rem; color: var(--bruise); }
</style>
